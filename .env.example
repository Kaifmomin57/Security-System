# ─────────────────────────────────────────────────
#  SentryEye — Environment Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────
DATABASE_URL=postgresql://postgres:admin%40123@localhost:5432/sentryeye



# ── Telegram Bot ─────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── API Security ─────────────────────────────────
API_KEY=changeme_secret_key

# ── Video Source ─────────────────────────────────
# Path to a local video file OR an RTSP URL
# Example file:  VIDEO_SOURCE=./media/test_cctv.mp4
# Example RTSP:  VIDEO_SOURCE=rtsp://192.168.1.100:554/stream
VIDEO_SOURCE=./media/test_cctv.mp4
CAMERA_ID=cam_01
CAMERA_NAME=Main Entrance

# ── Detection Settings ───────────────────────────
YOLO_MODEL=yolov8s.pt          # yolov8n.pt for lower VRAM, yolov8s.pt recommended for GTX 1650
DEVICE=cuda                    # use 'cpu' if GPU not available
FRAME_SKIP=                   # process every Nth frame (2 = every 2nd frame at 30fps)
DETECTION_CONFIDENCE=0.45
INPUT_WIDTH=640
INPUT_HEIGHT=640

# ── Alert Settings ───────────────────────────────
ALERT_COOLDOWN_SECONDS=30      # min seconds between same alert type per camera
LOITERING_THRESHOLD_SECONDS=60
TRAILING_DURATION_THRESHOLD=45
TEMPORAL_SMOOTHING_N=5         # rule must fire N out of M frames
TEMPORAL_SMOOTHING_M=8

# ── Media Storage ────────────────────────────────
MEDIA_DIR=./media
CLIP_PRE_SECONDS=10
CLIP_POST_SECONDS=5

# ── Privacy ──────────────────────────────────────
FACE_BLUR_ENABLED=true         # blur faces in stored clips by default
