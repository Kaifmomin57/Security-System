# ─────────────────────────────────────────────────
#  SentryEye — Environment Configuration
# ─────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────
DATABASE_URL=postgresql://postgres:admin%40123@localhost:5432/sentryeye

# ── Telegram Bot ─────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── API Security ─────────────────────────────────
API_KEY=changeme_secret_key

# ── Video Source ─────────────────────────────────
# Use '0' for default webcam, a file path, or an RTSP URL
VIDEO_SOURCE=0
CAMERA_ID=cam_01
CAMERA_NAME=Main Entrance

# ── Detection Settings ───────────────────────────
# yolov8n.pt for lower VRAM, yolov8s.pt recommended for GTX 1650
YOLO_MODEL=yolov8s.pt
# use 'cpu' if GPU not available
DEVICE=cuda
# process every Nth frame (2 = every 2nd frame at 30fps)
FRAME_SKIP=2
DETECTION_CONFIDENCE=0.45
INPUT_WIDTH=640
INPUT_HEIGHT=640

# ── Alert Settings ───────────────────────────────
# min seconds between same alert type per camera
ALERT_COOLDOWN_SECONDS=30
LOITERING_THRESHOLD_SECONDS=60
TRAILING_DURATION_THRESHOLD=45
# rule must fire N out of M frames
TEMPORAL_SMOOTHING_N=5
TEMPORAL_SMOOTHING_M=8

# ── Media Storage ────────────────────────────────
MEDIA_DIR=./media
CLIP_PRE_SECONDS=10
CLIP_POST_SECONDS=5

# ── Privacy ──────────────────────────────────────
# blur faces in stored clips by default
FACE_BLUR_ENABLED=true
