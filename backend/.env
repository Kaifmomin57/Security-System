# ─────────────────────────────────────────────────
#  SentryEye — Environment Configuration
# ─────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────
DATABASE_URL=postgresql://postgres:aryan%408291@localhost:5432/sentryeye

# ── Telegram Bot ─────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── API Security ─────────────────────────────────
API_KEY=changeme_secret_key

# ── Video Source ─────────────────────────────────
# Use '0' for default webcam, a file path, or an RTSP URL
VIDEO_SOURCE=./media/video3_alley.mp4
CAMERA_ID=cam_01
CAMERA_NAME=Main Entrance

# ── Detection Settings ───────────────────────────
# yolov8n.pt for lower VRAM, yolov8s.pt recommended for GTX 1650
YOLO_MODEL=yolov8n.pt
# use 'cpu' if GPU not available
DEVICE=cuda
# process every Nth frame (2 = every 2nd frame at 30fps)
FRAME_SKIP=2
DETECTION_CONFIDENCE=0.45
INPUT_WIDTH=640
INPUT_HEIGHT=640

# ── Alert Settings ───────────────────────────────
# min seconds between same alert type per camera
ALERT_COOLDOWN_SECONDS=30

